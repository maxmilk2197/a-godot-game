extends Control
## ============================================================
## 便利店：给金币一个消费出口。
## 用金币买礼物/甜点 → 增加好感 / 心情。
## ============================================================

const 商品数组 := [
	{"名": "草莓蛋糕", "价": 50, "好感": 8, "心情": 5, "说明": "阿云最爱的甜点"},
	{"名": "珍珠奶茶", "价": 20, "好感": 0, "心情": 10, "说明": "甜甜的现煮奶茶"},
	{"名": "小熊玩偶", "价": 80, "好感": 12, "心情": 3, "说明": "毛茸茸的小熊挂件"},
	{"名": "神秘礼物盒", "价": 120, "好感": 20, "心情": 0, "说明": "包装得漂漂亮亮的礼物"},
]

@onready var 余额标签: Label = $界面/余额
@onready var 商品列表: VBoxContainer = $界面/商品区/商品列表
@onready var 结果标签: Label = $界面/结果


func _ready() -> void:
	Raise.初始化()   # 无档则建默认档，有档则读取
	刷新余额()
	构建商品列表()


func 刷新余额() -> void:
	余额标签.text = "金币：%d" % Raise.金币


func 构建商品列表() -> void:
	for 商品 in 商品数组:
		var 按钮 := Button.new()
		按钮.custom_minimum_size = Vector2(0, 56)
		按钮.text = "%s　（%d 金币）" % [商品["名"], 商品["价"]]
		按钮.tooltip_text = 商品["说明"]
		按钮.pressed.connect(_购买.bind(商品))
		商品列表.add_child(按钮)


func _购买(商品: Dictionary) -> void:
	if Raise.金币 < int(商品["价"]):
		结果标签.text = "金币不够……回家做做家务赚点钱吧。"
		return
	Raise.增加金币(-int(商品["价"]))
	if int(商品["好感"]) > 0:
		Raise.增加好感(int(商品["好感"]))
	if int(商品["心情"]) > 0:
		Raise.增加心情(int(商品["心情"]))
	结果标签.text = "买下了%s！好感 +%d　心情 +%d" % [
		商品["名"], int(商品["好感"]), int(商品["心情"])
	]
	刷新余额()


func _on_返回按钮_pressed() -> void:
	get_tree().change_scene_to_file("res://场景/屋外/世界.tscn")