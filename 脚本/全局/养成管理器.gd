extends Node

## ============================================================
## 养成管理器（全局唯一，autoload 注册名：Raise）
## 负责保存并操作养成员属性，供「家」等所有场景共用。
## 数据存进 save 的 JSON 存档里（user://Saves/save_N.json）。
## 场景里用 Raise.心情、Raise.增加好感(2) 这样的写法。
## ============================================================

## ---- 属性（含默认初始值）----
var 心情: int = 60            ## 0-100
var 好感: int = 30            ## 0-100，和妹妹的亲密度
var 体力: int = 70            ## 0-100，精力
var 金币: int = 0             ## 金钱
var 游玩天数: int = 1         ## 从第 1 天开始（主菜单新游戏写的是 0，属正常）
var 时段: String = "白天"     ## "白天" 或 "晚上"
var 剩余行动点: int = 3       ## 每个时段可行动几次
var 当前场景: String = "res://场景/家/家.tscn"

## 数值上下限
const 上限 := 100
const 下限 := 0
const 每时段行动次数 := 3
const 睡觉恢复体力 := 70


## 读取存档里的养成数据；没有存档就按默认值开始并保存
func 初始化() -> void:
	if save.检查当前槽位有无存档():
		读取存档(save.加载())
	else:
		设定默认值()
		保存()


## 恢复成开局默认值
func 设定默认值() -> void:
	心情 = 60
	好感 = 30
	体力 = 70
	金币 = 0
	游玩天数 = 1
	时段 = "白天"
	剩余行动点 = 每时段行动次数


## 从存档字典读回属性
func 读取存档(数据: Dictionary) -> void:
	心情 = int(数据.get("心情", 60))
	好感 = int(数据.get("好感", 30))
	体力 = int(数据.get("体力", 70))
	金币 = int(数据.get("金币", 0))
	游玩天数 = int(数据.get("游玩天数", 1))
	时段 = str(数据.get("时段", "白天"))
	剩余行动点 = int(数据.get("剩余行动点", 每时段行动次数))


## 把当前属性存进 JSON 存档
func 保存() -> void:
	var 数据 = {
		"心情": 心情,
		"好感": 好感,
		"体力": 体力,
		"金币": 金币,
		"游玩天数": 游玩天数,
		"时段": 时段,
		"剩余行动点": 剩余行动点,
		"最后游玩场景": 当前场景,
	}
	save.保存(数据)


## ---- 属性修改（统一带边界限制，改完自动保存）----

func 增加心情(数量: int) -> void:
	心情 = clampi(心情 + 数量, 下限, 上限)
	保存()

func 增加好感(数量: int) -> void:
	好感 = clampi(好感 + 数量, 下限, 上限)
	保存()

func 变化体力(数量: int) -> void:
	体力 = clampi(体力 + 数量, 下限, 上限)
	保存()

func 增加金币(数量: int) -> void:
	金币 = max(金币 + 数量, 0)
	保存()


## 消耗一次行动点，成功返回 true
func 消耗行动点() -> bool:
	if 剩余行动点 <= 0:
		return false
	剩余行动点 -= 1
	保存()
	return true


## 随机浮动：基础值 ±2 抖动；
## 正数至少 +1，负数最多 -1，0 保持 0（妹相随式小随机）
func 随机浮动(基础值: int) -> int:
	if 基础值 > 0:
		return maxi(基础值 + randi_range(-2, 2), 1)
	if 基础值 < 0:
		return mini(基础值 + randi_range(-2, 2), -1)
	return 0


## ---- 时段与天数 ----

## 睡觉翻天：白天<->晚上切换；晚上->白天时天数+1；
## 行动点重置为 3；体力恢复到不低于 70（高于 70 不下降）
func 睡觉翻天() -> void:
	if 时段 == "白天":
		时段 = "晚上"
	else:
		时段 = "白天"
		游玩天数 += 1
	剩余行动点 = 每时段行动次数
	体力 = maxi(体力, 睡觉恢复体力)
	保存()
