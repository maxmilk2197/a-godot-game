extends Node

## ============================================================
## 养成系统测试（轻量 TDD，不需要装插件）
## 用法：godot --headless --log-file user://test.log --path 项目目录 res://场景/测试/养成测试.tscn
## 退出码：0 = 全部通过；1 = 有失败
## 测试用槽位 99 读写存档，跑完自动删除，不碰真实存档。
## ============================================================

var 失败数 := 0


func _ready() -> void:
	# 安全网：30 秒没跑完就报错退出
	get_tree().create_timer(30.0).timeout.connect(func(): get_tree().quit(1))
	# 等一帧，让所有 autoload 都准备好
	await get_tree().process_frame

	save.切换槽位(99)
	save.删除当前存档()

	测试_新档默认值()
	测试_属性修改与边界()
	测试_行动点()
	测试_睡觉翻天()
	测试_随机浮动范围()
	测试_存档往返()
	await 测试_场景装配()

	save.删除当前存档()
	print("======== 测试结束：", 失败数, " 个失败 ========")
	get_tree().quit(1 if 失败数 > 0 else 0)


func 检查(名字: String, ok: bool) -> void:
	if ok:
		print("[通过] ", 名字)
	else:
		失败数 += 1
		print("[失败] ", 名字)


## ---- S1：新档默认值 ----
func 测试_新档默认值() -> void:
	save.删除当前存档()
	Raise.初始化()
	检查("新档心情=60", Raise.心情 == 60)
	检查("新档好感=30", Raise.好感 == 30)
	检查("新档体力=70", Raise.体力 == 70)
	检查("新档金币=0", Raise.金币 == 0)
	检查("新档游玩天数=1", Raise.游玩天数 == 1)
	检查("新档时段=白天", Raise.时段 == "白天")
	检查("新档剩余行动点=3", Raise.剩余行动点 == 3)


## ---- S1：属性修改与边界（0~100 封顶、金币不低过 0）----
func 测试_属性修改与边界() -> void:
	Raise.设定默认值()
	Raise.增加心情(50)
	检查("心情+50 封顶100", Raise.心情 == 100)
	Raise.增加心情(-200)
	检查("心情-200 保底0", Raise.心情 == 0)
	Raise.增加好感(5)
	检查("好感+5=35", Raise.好感 == 35)
	Raise.变化体力(-30)
	检查("体力-30=40", Raise.体力 == 40)
	Raise.增加金币(100)
	Raise.增加金币(-500)
	检查("金币扣不低过0", Raise.金币 == 0)


## ---- S1：行动点 ----
func 测试_行动点() -> void:
	Raise.设定默认值()
	var 结果 := [
		Raise.消耗行动点(),
		Raise.消耗行动点(),
		Raise.消耗行动点(),
		Raise.消耗行动点(),
	]
	检查("前3次消耗都成功", 结果[0] and 结果[1] and 结果[2])
	检查("第4次消耗失败", not 结果[3])
	检查("行动点归0", Raise.剩余行动点 == 0)


## ---- S1：睡觉翻天（时段切换/天数/行动点/体力）----
func 测试_睡觉翻天() -> void:
	Raise.设定默认值()
	Raise.变化体力(-30)    # 体力 70 -> 40
	Raise.消耗行动点()      # 行动点 3 -> 2
	Raise.睡觉翻天()        # 白天 -> 晚上
	检查("睡醒时段=晚上", Raise.时段 == "晚上")
	检查("睡醒行动点重置为3", Raise.剩余行动点 == 3)
	检查("睡醒体力恢复到70", Raise.体力 == 70)
	检查("白天->晚上天数不变", Raise.游玩天数 == 1)
	Raise.体力 = 85
	Raise.睡觉翻天()        # 晚上 -> 白天
	检查("睡醒时段=白天", Raise.时段 == "白天")
	检查("晚上->白天天数+1", Raise.游玩天数 == 2)
	检查("体力高于70不下降", Raise.体力 == 85)


## ---- S3：随机浮动范围（基础值±2，正数至少+1，负数最多-1）----
func 测试_随机浮动范围() -> void:
	var 范围1 := true
	for i in 50:
		var v := Raise.随机浮动(3)
		if v < 1 or v > 5:
			范围1 = false
	var 范围2 := true
	for i in 50:
		var v := Raise.随机浮动(1)
		if v < 1 or v > 3:
			范围2 = false
	var 范围3 := true
	for i in 50:
		var v := Raise.随机浮动(-3)
		if v < -5 or v > -1:
			范围3 = false
	检查("随机浮动(3) 50次都在1~5", 范围1)
	检查("随机浮动(1) 50次都在1~3（至少+1）", 范围2)
	检查("随机浮动(-3) 50次都在-5~-1（保持负数）", 范围3)


## ---- S2：存档往返（写入 -> 重新读档 -> 一致）----
func 测试_存档往返() -> void:
	save.删除当前存档()
	Raise.初始化()          # 开新档
	Raise.增加好感(5)       # 好感 -> 35
	Raise.增加金币(100)     # 金币 -> 100
	Raise.变化体力(-20)     # 体力 -> 50
	Raise.消耗行动点()      # 行动点 -> 2
	Raise.保存()            # 显式写盘
	Raise.设定默认值()      # 内存清回默认，模拟“重新打开游戏”
	Raise.初始化()          # 从存档读回
	检查("重读后好感=35", Raise.好感 == 35)
	检查("重读后金币=100", Raise.金币 == 100)
	检查("重读后体力=50", Raise.体力 == 50)
	检查("重读后行动点=2", Raise.剩余行动点 == 2)


## ---- S4：家场景装配（面板/标签/按钮/做家务接线/对话同步）----
func 测试_场景装配() -> void:
	save.删除当前存档()
	Raise.初始化()
	var 家场景 = load("res://场景/家/家.tscn")
	检查("家场景能加载", 家场景 != null)
	if 家场景 == null:
		return
	var 实例 = 家场景.instantiate()
	add_child(实例)
	await get_tree().process_frame
	await get_tree().process_frame

	var 面板 = 实例.get_node_or_null("养成面板")
	检查("存在养成面板节点", 面板 != null)
	if 面板 == null:
		实例.queue_free()
		return
	for 路径 in [
		"属性面板/数值栏/心情数值",
		"属性面板/数值栏/好感数值",
		"属性面板/数值栏/体力数值",
		"属性面板/数值栏/金币数值",
		"属性面板/数值栏/天数数值",
		"属性面板/数值栏/时段数值",
		"属性面板/数值栏/行动点数值",
	]:
		检查("标签存在 " + 路径, 面板.get_node_or_null(路径) != null)
	for 按钮 in ["行动栏/交流", "行动栏/摸摸", "行动栏/做家务", "行动栏/睡觉", "行动栏/离开"]:
		检查("按钮存在 " + 按钮, 面板.get_node_or_null(按钮) != null)

	# 模拟点“做家务”：行动点-1、体力-12~-18、金币+15~+25
	var 金币前 := Raise.金币
	var 体力前 := Raise.体力
	var 行动点前 := Raise.剩余行动点
	面板._on_做家务_pressed()
	检查("做家务扣1行动点", Raise.剩余行动点 == 行动点前 - 1)
	检查("做家务金币+15~25", Raise.金币 >= 金币前 + 15 and Raise.金币 <= 金币前 + 25)
	检查("做家务体力-12~18", Raise.体力 >= 体力前 - 18 and Raise.体力 <= 体力前 - 12)

	# 对话同步：模拟对话里 set {好感} += 10（对话系统发出的信号）
	var 好感前 := Raise.好感
	Dialogic.VAR.variable_was_set.emit({
		"variable": "好感",
		"new_value": 好感前 + 10,
		"orig_value": 好感前,
		"value": 10,
		"value_str": "+= 10",
	})
	await get_tree().process_frame
	检查("对话变量同步回养成(变化8~12)", Raise.好感 >= 好感前 + 8 and Raise.好感 <= 好感前 + 12)

	实例.queue_free()
