layout_mode = 2
tooltip_text = "决定创建多少个 CSV 文件。\n\n• “按类型”：每种资源（时间线、角色和词条）使用一个 CSV 文件。\n例如，10 条时间线将合并为 1 个 CSV 文件。\n\n• “按文件”：每个资源文件使用一个 CSV 文件。\n例如，10 条时间线将生成 10 个 CSV 文件。\n\n“按文件”选项使用“输出位置”，而“按类型”始终使用翻译文件夹。"
texture = SubResource("ImageTexture_xbph7")
hint_text = "决定创建多少个 CSV 文件。\n\n• “按类型”：每种资源（时间线、角色和词条）使用一个 CSV 文件。\n例如，10 条时间线将合并为 1 个 CSV 文件。\n\n• “按文件”：每个资源文件使用一个 CSV 文件。\n例如，10 条时间线将生成 10 个 CSV 文件。\n\n“按文件”选项使用“输出位置”，而“按类型”始终使用翻译文件夹。"

