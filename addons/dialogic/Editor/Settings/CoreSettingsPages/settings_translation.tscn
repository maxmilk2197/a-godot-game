[node name="EraseConfirmationDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
position = Vector2i(0, 36)
size = Vector2i(500, 280)
min_size = Vector2i(300, 70)
ok_button_text = "全部删除"
dialog_text = "你即将执行以下操作：\n-   删除所有以 \"dialogic_\" 为前缀的 CSV。\n-   删除相关的 CSV 导入文件。\n-   删除相关的翻译文件。\n-   从时间线和角色中移除翻译 ID。\n-   从“项目设置 -> 本地化”中移除所有以 \"dialogic\" 为前缀的翻译。\n-   移除 \"_translation_keys\" 以及以 \"Glossary/\" 开头的 \"entries\"。"
dialog_autowrap = true

