## 取一个形状的轮廓点（单位圆内，半径 ≤ 1）
static func 取(名: String) -> PackedVector2Array:
	if _缓存 == null:
		_缓存 = {}
	if _缓存.has(名):
		return _缓存[名]
	var 串: String = _半径表.get(名, _定量半径.get(名, ""))
	if 串.is_empty():
		push_warning("M3MaterialShapes 没有这个形状：" + 名)
		return PackedVector2Array()
	var 段 := 串.split(",", false)
	var 点 := PackedVector2Array()
	点.resize(段.size())
	for i in range(段.size()):
		var r := float(int(段[i])) * 0.0001
		var 角 := TAU * float(i) / float(段.size())
		点[i] = Vector2(cos(角) * r, sin(角) * r)
	_缓存[名] = 点
	return 点


## 在两张形状之间插值（两张的点数必须一致）
static func 插值(甲: PackedVector2Array, 乙: PackedVector2Array, 进度: float) -> PackedVector2Array:
	var 数 := mini(甲.size(), 乙.size())
	var 点 := PackedVector2Array()
	点.resize(数)
	for i in range(数):
		点[i] = 甲[i].lerp(乙[i], 进度)
	return 点
